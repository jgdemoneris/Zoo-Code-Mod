branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ]; then
  echo "You can't commit directly to main - please check out a branch."
  exit 1
fi

# Prefer the repository's declared package manager. On Windows, use the .exe
# shim explicitly so Git Bash does not select a stale Unix npx earlier in PATH.
if command -v pnpm.exe >/dev/null 2>&1; then
	pnpm.exe exec lint-staged
elif command -v pnpm.cmd >/dev/null 2>&1; then
	pnpm.cmd exec lint-staged
elif command -v pnpm >/dev/null 2>&1; then
	pnpm exec lint-staged
elif command -v npx.exe >/dev/null 2>&1; then
	npx.exe --no-install lint-staged
elif command -v npx >/dev/null 2>&1; then
	npx --no-install lint-staged
else
	echo "Neither pnpm nor npx was found; cannot run lint-staged."
	exit 127
fi
